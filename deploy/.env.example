# 배포 서버용: 이 파일을 같은 폴더에 .env로 복사하고 값을 채운다. (.env는 Git에 올라가지 않는다)
# 비밀번호는 영문·숫자만 사용 ($, #, 따옴표는 다른 의미로 해석될 수 있음). 개발 PC와 다른 값으로 새로 만든다.

# RDS 주소 (RDS 화면의 "엔드포인트", 예: macros.xxxx.ap-northeast-2.rds.amazonaws.com)
DB_HOST=
# RDS를 만들 때 정한 마스터 비밀번호 (마스터 사용자 이름은 macros로 만든다)
MYSQL_PASSWORD=

# 사진을 저장할 S3 버킷 이름 (S4-3에서 만든다)
APP_S3_BUCKET=

# Gemini API 키 (AI 기능 배포 때 채운다)
GEMINI_API_KEY=
