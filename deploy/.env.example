# 배포 서버용: 이 파일을 같은 폴더에 .env로 복사하고 값을 채운다. (.env는 Git에 올라가지 않는다)
# 비밀번호는 영문, 숫자만 사용 ($, #, 따옴표는 다른 의미로 해석될 수 있음). 개발 PC와 다른 값으로 새로 만든다.

# RDS 주소 (RDS 화면의 "엔드포인트", 예: macros.xxxx.ap-northeast-2.rds.amazonaws.com)
DB_HOST=
# RDS를 만들 때 정한 마스터 비밀번호 (마스터 사용자 이름은 macros로 만든다)
MYSQL_PASSWORD=

# 사진을 저장할 S3 버킷 이름 (S4-3에서 만든다)
APP_S3_BUCKET=

# Gemini API 키 (Google AI Studio → Get API key). 비어 있으면 AI 분석이 실패로 저장된다.
GEMINI_API_KEY=

# 운영자 API 열쇠 (S3-3). 긴 무작위 문자열로 만든다:  openssl rand -hex 24
# 요청 헤더 X-Admin-Token에 이 값을 보내면 운영자로 본다. 비워 두면 운영자 기능이 꺼진다. 새면 값을 바꾸고 bash deploy.sh current (끊김 없이 다시 켬)
APP_ADMIN_TOKEN=

# 관리자 화면 비밀번호 (JM-82). 비밀번호 관리자에서 긴 무작위 값으로 만든다. 비워 두면 /admin은 404(꺼짐)
# 넣고 bash deploy.sh current 한 뒤, 바로 쓸 노트북의 브라우저로 /admin에 들어가 기기를 등록한다 (기획서 16절)
APP_ADMIN_PASSWORD=

# app 두 자리(app1, app2)가 실행할 이미지의 태그(커밋 SHA). 배포(deploy.sh)가 바꿔치기에 성공한 뒤 알아서 적으므로 직접 채우지 않는다. 없으면 latest
# (2026-11-23 무중단 배포 전에는 APP_IMAGE_TAG 하나였다. 서버 .env에 남아 있어도 쓰이지 않는다)
# APP1_TAG=
# APP2_TAG=
